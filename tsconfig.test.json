{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["jest", "node"]
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/*.spec.ts",
    "jest.config.ts"
  ]
}
